<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SslrExperience</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExpressiveParser" Version="3.0.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Mutagen.Bethesda" Version="0.54.4" />
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled from Papyrus/Source; written to Data/Scripts by the patcher -->
    <EmbeddedResource Include="Papyrus/Scripts/*.pex" LogicalName="Scripts.%(Filename)%(Extension)" />
    <None Remove="Papyrus/**" />
  </ItemGroup>
</Project>
